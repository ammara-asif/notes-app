<mxfile host="app.diagrams.net">
  <diagram id="quicknotes" name="QuickNotes architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1170" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;QuickNotes&lt;/b&gt; - 3-tier web app + event-driven async worker (docker-compose)" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="900" height="30" as="geometry" />
        </mxCell>

        <!-- Docker compose network boundary -->
        <mxCell id="net" value="Docker Compose network (services reach each other by name)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;fontColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="50" width="900" height="540" as="geometry" />
        </mxCell>

        <!-- Tier lanes -->
        <mxCell id="tier1" value="&lt;b&gt;Presentation tier&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="220" y="80" width="240" height="490" as="geometry" />
        </mxCell>
        <mxCell id="tier2" value="&lt;b&gt;Application tier&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="80" width="260" height="490" as="geometry" />
        </mxCell>
        <mxCell id="tier3" value="&lt;b&gt;Data tier&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="780" y="80" width="300" height="490" as="geometry" />
        </mxCell>

        <!-- Components -->
        <mxCell id="browser" value="&lt;b&gt;User's browser&lt;/b&gt;&lt;br&gt;index.html + app.js&lt;br&gt;&lt;i&gt;polls every 2s&lt;br&gt;shows toast&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="245" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="nginx" value="&lt;b&gt;frontend&lt;/b&gt; (nginx:alpine)&lt;br&gt;localhost:8080 → :80&lt;br&gt;serves static files&lt;br&gt;reverse-proxies /api/*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="245" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;api&lt;/b&gt; (FastAPI, :8000)&lt;br&gt;GET /api/health&lt;br&gt;GET /api/notes&lt;br&gt;POST /api/notes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="140" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="worker" value="&lt;b&gt;worker&lt;/b&gt; (Python)&lt;br&gt;BRPOP loop&lt;br&gt;send notification (~2s)&lt;br&gt;mark note notified" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="420" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pg" value="&lt;b&gt;db&lt;/b&gt; (PostgreSQL 16)&lt;br&gt;table: notes&lt;br&gt;status: pending → notified" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="830" y="130" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="vol" value="volume: pgdata" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="870" y="262" width="110" height="34" as="geometry" />
        </mxCell>
        <mxCell id="redis" value="&lt;b&gt;redis&lt;/b&gt; (Redis 7)&lt;br&gt;list: notes_queue&lt;br&gt;&lt;i&gt;= message queue&lt;/i&gt;" style="shape=mxgraph.flowchart.direct_data;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="830" y="420" width="190" height="90" as="geometry" />
        </mxCell>

        <!-- Flows -->
        <mxCell id="e1" value="1. HTTP :8080&lt;br&gt;POST /api/notes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="browser" target="nginx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="2. proxy&lt;br&gt;→ api:8000" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#dae8fc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="nginx" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="3. INSERT&lt;br&gt;(pending)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="api" target="pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="4. LPUSH note_id" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="api" target="redis">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="670" y="360" />
              <mxPoint x="878" y="360" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" value="5. BRPOP" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="redis" target="worker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="6. UPDATE status='notified'" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="worker" target="pg">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="620" y="545" />
              <mxPoint x="1055" y="545" />
              <mxPoint x="1055" y="180" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" value="7. poll GET /api/notes every 2s → pending → notified → toast" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="browser" target="nginx">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="90" y="400" />
              <mxPoint x="340" y="400" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Legend / cloud mapping -->
        <mxCell id="legend" value="&lt;b&gt;Why async?&lt;/b&gt; The API answers in milliseconds; the slow notification runs in the worker. If the worker is down, jobs wait in Redis and are processed when it returns.&lt;br&gt;&lt;b&gt;Cloud mapping (AWS):&lt;/b&gt; nginx → S3 + CloudFront / ALB · FastAPI → ECS Fargate · Postgres → RDS · Redis queue → SQS · worker → Lambda (SQS trigger)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="610" width="1080" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
